# Safe for the browser. Find these in Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional canonical URL used for auth redirects in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Add only when implementing Auth Admin operations; never prefix
# this variable with NEXT_PUBLIC_ and never access it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
